# .env.example
# Copy this file to .env and configure for production

APP_NAME="AI-Driven Secure File Sharing"
MAX_UPLOAD_SIZE=104857600
KEY_PASSPHRASE="your_secure_passphrase_here"
JWT_SECRET_KEY="your_secure_jwt_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL="sqlite:///./audit_log.db"
